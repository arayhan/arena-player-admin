# dependencies
node_modules/
.pnp
.pnp.*

# next
.next/
out/
build/
next-env.d.ts

# env — never commit any of these
.env
.env*.local
.mcp.json

# secrets scratch: the hash-generation script writes nothing, but people paste into files
*.secret
*.secret.*

# testing / coverage
coverage/

# tsc --noEmit incremental cache
tsconfig.tsbuildinfo

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# lockfiles from the wrong package manager — pnpm only
package-lock.json
yarn.lock

# parallel-feature checkouts — see docs/rules/worktrees.md
.worktrees/

# claude local
.claude/settings.local.json
.claude/.session-head
.claude/screenshots/
.gstack/

# impeccable live mode. config.json is portable project config and is kept so
# the next session skips setup; roots.json and the session journal hold
# absolute paths from whichever machine ran it, and must not travel.
.impeccable/*
!.impeccable/live/
.impeccable/live/*
!.impeccable/live/config.json
