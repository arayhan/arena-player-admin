# Arena Player — Admin. Copy to .env.local and fill. Never commit .env.local.
# Seven vars. Five are shared infrastructure with arena-player-web; two are this app's own.
# Setup notes live in docs/database.md (Neon, R2) and docs/architecture.md (auth, cron).

# --- Shared infrastructure ---------------------------------------------------

# Neon POOLED connection string — the host contains "-pooler". The direct string
# exhausts connections under concurrent serverless invocations. Same database as
# arena-player-web. This app writes bookings.status; it never runs DDL.
DATABASE_URL=

# Cloudflare R2. Same account and same bucket as web.
R2_ACCOUNT_ID=
R2_BUCKET=arena-player-proofs

# THIS IS A DIFFERENT KEY FROM THE WEB REPO'S. Create a second R2 API token
# scoped "Object Read only" on arena-player-proofs alone. Three reasons, any one
# sufficient: an admin-side compromise then cannot delete or overwrite payment
# evidence; web's credential is handed to the client at handover, so sharing one
# key means one rotation breaks two apps; and the admin has no legitimate reason
# to ever write to the bucket.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- This app's own ----------------------------------------------------------

# argon2id hash of the admin password. THE HASH, NEVER THE PASSWORD.
# Generate with the script from docs/architecture.md (hash-wasm, not @node-rs/argon2 —
# Sumopod's build environment is unverified and native bindings fail at deploy time).
# Starts with $argon2id$.
ADMIN_PASSWORD_HASH=

# HS256 signing key for the session JWT. >= 32 random bytes, base64.
# Rotating it logs the admin out; that is the intended behaviour, not a bug.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Bearer token the external scheduler sends to POST /api/jobs/expire.
# Without a scheduler holding this value, pending bookings are never expired and
# abandoned slots on the PUBLIC site stay held forever. See docs/PRD.md Phase 3.
CRON_SECRET=
